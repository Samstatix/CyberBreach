# Standalone Vite development
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_CYBERBREACH_LAB_PORTAL_URL=

# Later Next.js / Vercel integration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_CYBERBREACH_LAB_PORTAL_URL=

# Trusted server-only secrets are never prefixed with VITE_ or NEXT_PUBLIC_.
# Do not add the Supabase service-role key to frontend environment variables.
SUPABASE_SERVICE_ROLE_KEY=
LAB_ORCHESTRATOR_TOKEN=

# CYRO server-side Ollama connection (Supabase Edge Function secrets only)
# Must be a reachable HTTPS endpoint from Supabase Edge Functions, ending in /api/chat.
CYRO_OLLAMA_URL=
CYRO_OLLAMA_MODEL=llama3.1:8b
CYRO_OLLAMA_API_KEY=


# Supabase Edge Function secrets (set in Supabase, never in Vercel client variables)
CYBERBREACH_ALLOWED_ORIGIN=https://YOUR-PRODUCTION-DOMAIN
CYRO_OLLAMA_URL=https://YOUR-PRIVATE-OLLAMA-ENDPOINT
CYRO_OLLAMA_MODEL=llama3.1:8b
CYRO_OLLAMA_API_KEY=
CYRO_TIMEOUT_MS=45000
CYRO_MAX_TOKENS=500
