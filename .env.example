# Browser-safe Supabase settings.
# These two values are public client configuration, not service credentials.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Trusted server-side settings for a future Fastify/lab orchestration service.
# NEVER prefix service credentials with VITE_ or expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=
